# SmartCampus AI - Environment Variables
# Copy to .env and adjust values for your environment

PROJECT_NAME="SmartCampus AI"
ENVIRONMENT="development"
DEBUG=True

# Security & JWT
SECRET_KEY="replace-this-with-a-secure-random-secret-key-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL="sqlite:///./smartcampus.db"

# ML & Biometrics Configuration
FACE_MATCH_THRESHOLD=0.45
RISK_MODEL_PATH="./app/ml/risk_predictor.joblib"
ATTENDANCE_CRITICAL_CUTOFF_PCT=75.0

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"
